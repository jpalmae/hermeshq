# HermesHQ Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Concurrency — max concurrent task runner processes (default: 8)
# Each process uses ~50MB RAM. For sizing: available_RAM_MB / 60
CONCURRENCY_SEMAPHORE=8

# Database
POSTGRES_DB=hermeshq
POSTGRES_USER=hermeshq
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Backend
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Encryption key for secrets at rest (independent from JWT_SECRET so either
# can rotate without breaking the other). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Initial local administrator password. Required outside DEBUG mode.
ADMIN_PASSWORD=
# Development only. Never enable in an internet-facing deployment.
DEBUG=false
# Required outside DEBUG mode. Set false only for local HTTP development.
COOKIE_SECURE=true
# Max seconds a single task may run before being killed (default: 3600)
TASK_TIMEOUT_SECONDS=3600
AGENT_SERVICE_TOKEN_DAYS=30
# Required by Docker Compose. Generate with: openssl rand -hex 32
RUNTIME_RUNNER_TOKEN=
# Bare-metal development may use subprocess; production requires required.
RUNTIME_ISOLATION_MODE=subprocess
RUNTIME_CONTAINER_MEMORY=768m
RUNTIME_CONTAINER_CPUS=1.0
RUNTIME_CONTAINER_PIDS=256
# Add custom provider domains as comma-separated hostnames.
RUNTIME_EGRESS_ALLOWLIST=
AUTH_MODE=local
BACKEND_PORT=8000
FRONTEND_PORT=3420
